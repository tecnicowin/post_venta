{
  "name": "generador-licencias-pdv",
  "version": "1.0.0",
  "description": "Generador de Licencias - Punto de Venta",
  "main": "main.js",
  "author": "Tecnicowin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . GeneradorLicencias --platform=win32 --arch=x64 --out=../build-licenses --overwrite --ignore=\"node_modules\" --ignore=\".git\" --asar"
  },
  "build": {
    "appId": "com.tecnicowin.generadorlicencias",
    "productName": "GeneradorLicencias",
    "directories": {
      "output": "../build-licenses"
    },
    "files": [
      "main.js",
      "preload.js",
      "generador-licencias.html"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/icons/icon-512.png",
      "artifactName": "GeneradorLicencias.${ext}"
    },
    "portable": {
      "artifactName": "GeneradorLicencias.${ext}"
    },
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-packager": "^17.1.2"
  }
}

{
  "name": "punto-de-venta-installer",
  "version": "1.0.0",
  "description": "Instalador Punto de Venta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"Instalar Punto de Venta\" --platform=win32 --arch=x64 --out=./build --overwrite --ignore=\"node_modules\" --ignore=\".git\" --asar"
  },

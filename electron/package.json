{
  "name": "punto-de-venta",
  "version": "1.0.0",
  "description": "Sistema de Facturación - Punto de Venta",
  "main": "main.js",
  "author": "Tecnicowin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . PuntoDeVenta --platform=win32 --arch=x64 --out=../build --overwrite --ignore=\"node_modules\" --ignore=\".git\" --asar"
  },
  "build": {
    "appId": "com.tecnicowin.puntodeventa",
    "productName": "PuntoDeVenta",
    "directories": {
      "output": "../build"
    },
    "files": [
      "main.js",
      "preload.js",
      "../index.html",
      "../css/**/*",
      "../js/**/*",
      "../assets/**/*",
      "../sw.js",
      "../manifest.json",
      "!../tools/**",
      "!../docs/**",
      "!../debug.html",
      "!../PLAN.md",
      "!../Sistema.txt",
      "!../generate-icons.js",
      "!../updates.json",
      "!../.gitignore",
      "!../cloudflare-worker/**"
    ],
    "asar": true,
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/icons/icon-512.png",
      "artifactName": "PuntoDeVenta.${ext}",
      "sign": false,
      "signingHashAlgorithms": []
    },
    "portable": {
      "artifactName": "PuntoDeVenta.${ext}"
    },
    "compression": "maximum",
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2"
  }
}
